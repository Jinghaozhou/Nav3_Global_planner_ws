<?xml version="1.0"?>
<package format="3">
  <name>pct_planner</name>
  <version>0.2.0</version>
  <description>Offline point-cloud tomography and service-driven 3D global planning.</description>
  <maintainer email="pct-planner@example.com">PCT Planner</maintainer>
  <license>GPL-2.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>pct_planner_interfaces</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
